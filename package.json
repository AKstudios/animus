{
  "name": "animus",
  "version": "0.6.0",
  "private": true,
  "description": "A software factory on Claude Code: a spec goes in, a pull request with proof comes out.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "sh scripts/with-tmp.sh node --disable-warning=ExperimentalWarning --test 'plugin/test/**/*.test.ts' 'helix/test/**/*.test.ts' 'scripts/test/**/*.test.ts'",
    "changelog": "node -e \"console.log('release notes are written by npm run release from merged pull requests')\"",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
